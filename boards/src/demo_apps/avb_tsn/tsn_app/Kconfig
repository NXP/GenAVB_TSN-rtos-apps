menu "GenAVB/TSN TSN App configuration"
config MCUX_PRJSEG_config.board.tsn_app
    bool
    default y

config MCUX_PRJSEG_config.board.app_tsn_endpoint
    bool
    default y if APP_TSN_ENDPOINT
    select MCUX_COMPONENT_component.rtos_apps.tsn
    select MCUX_COMPONENT_component.rtos_apps.tsn.lwip if APP_LWIP
    select APP_USER_BUTTON if ((MCUX_HW_DEVICE_ID_MIMXRT1189xxxxx || MCUX_HW_DEVICE_ID_MIMXRT1176xxxxx) && MCUX_HW_CORE_CM7F)

config APP_TSN_ENDPOINT
    bool "TSN Endpoint support"
    default n

config APP_USER_BUTTON
    bool "User Button support"
    default n
    select MCUX_COMPONENT_component.rtos_apps.user_button

config APP_SERIAL
    bool "Serial support"
    default n
    select MCUX_COMPONENT_component.rtos_apps.serial

config MCUX_PRJSEG_config.board.app_motor_iodevice
    bool
    default y if APP_MOTOR_IO_DEVICE
    select MCUX_COMPONENT_component.rtos_apps.tsn.motor.iodevice
    select MCUX_COMPONENT_middleware.rtcesl.cm7f
    select MCUX_COMPONENT_driver.lpadc
    select MCUX_COMPONENT_driver.eqdc if MCUX_HW_DEVICE_ID_MIMXRT1189xxxxx && MCUX_HW_CORE_CM7F
    select MCUX_COMPONENT_driver.xbar_1 if MCUX_HW_DEVICE_ID_MIMXRT1189xxxxx && MCUX_HW_CORE_CM7F
    select MCUX_COMPONENT_driver.enc if MCUX_HW_DEVICE_ID_MIMXRT1176xxxxx && MCUX_HW_CORE_CM7F
    select MCUX_COMPONENT_driver.xbara if MCUX_HW_DEVICE_ID_MIMXRT1176xxxxx && MCUX_HW_CORE_CM7F
    select MCUX_COMPONENT_driver.adc_etc if MCUX_HW_DEVICE_ID_MIMXRT1176xxxxx && MCUX_HW_CORE_CM7F

config MCUX_PRJSEG_config.board.app_motor_controller
    bool
    default y if APP_MOTOR_CONTROLLER
    select MCUX_COMPONENT_component.rtos_apps.tsn.motor.controller
    select MCUX_COMPONENT_component.rtos_apps.tsn.lwip if APP_LWIP

rsource "../common/Kconfig"
rsource "../common/Kconfig.prjseg"
source "${SdkRootDirPath}/${board_root}/${board}/demo_apps/avb_tsn/tsn_app/Kconfig"
endmenu

source "${SdkRootDirPath}/Kconfig.mcuxpresso"
