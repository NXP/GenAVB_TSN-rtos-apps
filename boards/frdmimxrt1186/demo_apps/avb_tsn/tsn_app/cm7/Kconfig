choice MCUX_PRJSEG_config.board.build_cfg_sel
    prompt "FRDMIMXRT1186 EVK CM7 TSN configuration options"
    default MCUX_PRJSEG_config.board.app_default

    config MCUX_PRJSEG_config.board.app_default
        bool "TSN application Endpoint default configuration"
        select APP_TSN_ENDPOINT
        select APP_USER_BUTTON
        select MCUX_COMPONENT_driver.xbar_1

endchoice

config MCUX_PRJSEG_config.board.tsn_motor_controller
    bool "FRDMIMXRT1186 EVK CM7 TSN Motor Controller configuration"
    default n
    select APP_MOTOR_CONTROLLER

config MCUX_PRJSEG_config.board.tsn_motor_iodevice
    bool "FRDMIMXRT1186 EVK CM7 TSN Motor IO-device configuration"
    default n
    select APP_MOTOR_IO_DEVICE
    select APP_LWIP
